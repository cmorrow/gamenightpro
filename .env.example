# 32+ char random string. Encrypts the session cookie. Generate: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# First admin account, created only when no users exist yet.
NUXT_SEED_ADMIN_EMAIL=admin@gamenight.local
NUXT_SEED_ADMIN_PASSWORD=

# User store. Leave empty locally (files in .data/). In Azure use Table Storage:
# NUXT_STORAGE_DRIVER=azure-storage-table
# NUXT_AZURE_STORAGE_CONNECTION_STRING=

# Public site URL, used for the Customer Portal's return link. Optional (defaults to the request host).
# NUXT_SITE_URL=https://your-site.azurestaticapps.net

# Stripe Music Bingo subscription ($14.99/month, 7-day trial).
# Billing stays off until this price and the publishable and secret keys are set.
# Use test-mode keys (pk_test_/sk_test_) until you're ready to take real payments. Never commit real values.
# The publishable key is public (it ships to the browser); the secret key and webhook secret are not.
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NUXT_STRIPE_SECRET_KEY=
# Music Bingo $14.99/month Stripe Price.
NUXT_STRIPE_SINGLE_GAME_PRICE_ID=
# Future All games Pro price; not required for current billing.
NUXT_STRIPE_PRICE_ID=
# From `stripe listen` locally, or the webhook endpoint's signing secret in the Stripe Dashboard.
NUXT_STRIPE_WEBHOOK_SECRET=
# Stripe Tax: set to true once tax registrations and the price's tax behavior are set in the Dashboard.
# NUXT_STRIPE_AUTOMATIC_TAX=true
